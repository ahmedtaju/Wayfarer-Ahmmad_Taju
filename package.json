{
  "name": "wayfarer-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=web",
    "start": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run start --workspace=api\" \"npm run start --workspace=web\"",
    "seed": "npm run seed --workspace=api",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
