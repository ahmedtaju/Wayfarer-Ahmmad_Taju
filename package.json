{
  "name": "wayfarer-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=api && npm run build --workspace=web",
    "typecheck": "npm run typecheck --workspace=api && tsc --noEmit -p web/tsconfig.json",
    "lint": "eslint api/src web/src web/e2e scripts playwright.config.ts --max-warnings=0",
    "test:e2e": "node scripts/test-browser.mjs",
    "start": "concurrently -k -n \"api,web\" -c \"blue,green\" \"npm run start --workspace=api\" \"npm run start --workspace=web\"",
    "seed": "npm run seed --workspace=api",
    "test": "node scripts/test.mjs",
    "test:watch": "node scripts/test.mjs --watch"
  },
  "dependencies": {
    "concurrently": "^9.1.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
